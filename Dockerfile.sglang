# SGLang-Omni High-Throughput Continuous-Batching GPU Backend for Audio8-TTS
FROM hongccc/sglang-omni:dev

WORKDIR /opt

# 1. Install git, curl, sglang-omni pinned revision, and align huggingface-hub with transformers
RUN apt-get update && apt-get install -y --no-install-recommends git curl ca-certificates && rm -rf /var/lib/apt/lists/* && \
    git clone https://github.com/sgl-project/sglang-omni.git /opt/sglang-omni && \
    cd /opt/sglang-omni && \
    git checkout 68a572348837f7b004857b4b07993c20ade4c017 && \
    python3 -m pip install --no-cache-dir --no-deps -e /opt/sglang-omni && \
    python3 -m pip uninstall -y kernels flashinfer-jit-cache || true && \
    rm -rf /opt/sglang/lib/python3.12/site-packages/flashinfer_jit_cache* && \
    python3 -m pip install --no-cache-dir "huggingface-hub>=0.34.0,<1.0"

# 2. Copy and install Audio8 adapter
COPY sglang_omni /opt/audio8-adapter

RUN chmod +x /opt/audio8-adapter/scripts/*.sh && \
    sed -i 's/\r$//' /opt/audio8-adapter/scripts/*.sh && \
    SGLANG_OMNI_PACKAGE="$(python3 -c 'import importlib.util, pathlib; s=importlib.util.find_spec("sglang_omni"); assert s and s.origin; print(pathlib.Path(s.origin).parent)')" && \
    bash /opt/audio8-adapter/scripts/install_adapter.sh "${SGLANG_OMNI_PACKAGE}"

ENV SGLANG_OMNI_ROOT=/opt/sglang-omni \
    AUDIO8_TTS_STREAM_ENABLED=1 \
    AUDIO8_TTS_ATTENTION_BACKEND=flashinfer \
    AUDIO8_TTS_MEM_FRACTION_STATIC=0.25 \
    AUDIO8_TTS_MAX_RUNNING_REQUESTS=32 \
    AUDIO8_TTS_DISABLE_CUDA_GRAPH=0 \
    FLASHINFER_WORKSPACE_BASE=/tmp/audio8-flashinfer \
    FLASHINFER_DISABLE_VERSION_CHECK=1 \
    HOST=0.0.0.0 \
    PORT=8010

EXPOSE 8010

ENTRYPOINT ["/bin/bash", "/opt/audio8-adapter/scripts/run_server.sh"]
