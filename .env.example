# Hugging Face Access Token (required to download private/gated phosai/realistic-v1)
# Create a read token at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Model configuration
MODEL=phosai/realistic-v1
MODEL_ID=phosai/realistic-v1

# Target ports
PORT=18473
ARKTTS_DEVICE=auto
OUTPUT_SAMPLE_RATE=16000

