# Hugging Face Access Token (required to download private/gated phosai/realistic-v1 during build)
# Create a read token at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Model configuration
MODEL_ID=phosai/realistic-v1
EXPORT_PRECISION=fp16,fp32

# Runtime configuration
PORT=18473
ARKTTS_DEVICE=auto
ARKTTS_PRECISION=fp16
ARKTTS_WORKERS=1
OUTPUT_SAMPLE_RATE=16000
